{
  "name": "@jeonhui/agentbridge",
  "version": "0.1.4",
  "description": "A headless local runtime that connects installed AI agent CLIs to any program, with MCP tools and permissions",
  "keywords": [
    "agentbridge",
    "ai-agent",
    "mcp",
    "claude",
    "codex",
    "local-first",
    "runtime"
  ],
  "license": "MIT",
  "author": "Jeonhui Lee <l06094@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeonhui/agent-bridge.git",
    "directory": "packages/agentbridge"
  },
  "homepage": "https://github.com/Jeonhui/agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/Jeonhui/agent-bridge/issues"
  },
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./claude": {
      "types": "./dist/provider/claude/index.d.ts",
      "default": "./dist/provider/claude/index.js"
    },
    "./codex": {
      "types": "./dist/provider/codex/index.d.ts",
      "default": "./dist/provider/codex/index.js"
    },
    "./provider": {
      "types": "./dist/provider/core/index.d.ts",
      "default": "./dist/provider/core/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/manager/index.d.ts",
      "default": "./dist/mcp/manager/index.js"
    },
    "./mcp-server": {
      "types": "./dist/mcp/server/index.d.ts",
      "default": "./dist/mcp/server/index.js"
    },
    "./permission": {
      "types": "./dist/permission/index.d.ts",
      "default": "./dist/permission/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/testing",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test dist",
    "prepublishOnly": "node -e \"if(!(process.env.npm_config_user_agent||'').includes('pnpm')){console.error('\\\\nPublish with pnpm. npm leaves the workspace: protocol in dependencies, which produces a tarball npm itself cannot install (EUNSUPPORTEDPROTOCOL).\\\\n');process.exit(1)}\" && tsc -b"
  }
}
